---
const MORE = [
  {
    title: "CertiCamper",
    image: "/screenshots/certicamper.webp",
    alt: "CertiCamper's landing page: homologate your camper, simply and quickly.",
    text: "A platform for a vehicle engineering consultancy that moved camper homologation out of email threads and into one guided workflow, with roles for clients and engineers.",
    stack: "FastAPI, React, PostgreSQL, Docker",
    links: [],
  },
  {
    title: "U.D.I.N.",
    image: "/screenshots/UDIN.webp",
    alt: "U.D.I.N. desktop windows: a new modification form and a document generation menu.",
    text: "A desktop app for the same consultancy that writes the official engineering documents for vehicle modifications in Spain, replacing repetitive manual paperwork.",
    stack: "C#, WPF",
    links: [],
  },
  {
    title: "Drumscribe AI",
    image: "/screenshots/drumscribe-ai.webp",
    alt: "Mel spectrogram of a jazz drum fill above the ground-truth and predicted drum hits.",
    text: "A deep learning model that listens to drum recordings and writes them out as General MIDI.",
    stack: "PyTorch",
    links: [
      { label: "Code", href: "https://github.com/LittleHaku/DrumScribe-AI" },
      { label: "Slides", href: "https://docs.google.com/presentation/d/e/2PACX-1vRZMLv54Lwds3XjPzL-EkvlxaNIu4ZqrGLiD8GjuV42B5Cri0M5aMMj-cHX-8UGUVEaHpDuh8Z1HQRC/pub" },
    ],
  },
];
---

<section id="projects" class="projects">
  <div class="wrap">
    <h2 class="section-title" data-reveal><span>Other things I built</span></h2>
  </div>

  <article class="featured" data-reveal>
    <div class="wrap featured-grid">
      <div class="featured-copy">
        <h3>Obsidian Smart Export</h3>
        <p class="downloads">Close to <span class="num">3,000</span> downloads</p>
        <p>
          An open-source Obsidian plugin that follows the links between your notes and exports them
          as one Markdown file, ready to paste into an LLM or print as a PDF.
        </p>
        <p class="links">
          <a class="link" href="https://smart-export.vercel.app/">Website</a>
          <a class="link" href="https://github.com/LittleHaku/obsidian-smart-export">Code</a>
        </p>
      </div>
      <div class="featured-shot">
        <img
          src="/screenshots/obsidian-smart-export.webp"
          alt="Smart Export's website: export context, not just notes."
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </article>

  <div class="wrap">
    <ul class="more">
      {MORE.map((project) => (
        <li data-reveal>
          <div class="thumb">
            <img src={project.image} alt={project.alt} loading="lazy" decoding="async" />
          </div>
          <div>
            <h3>{project.title}</h3>
            <p>{project.text}</p>
            <p class="muted stack">{project.stack}</p>
            {project.links.length > 0 && (
              <p class="links">
                {project.links.map((link) => (
                  <a class="link" href={link.href}>{link.label}</a>
                ))}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projects {
    margin-top: var(--section-gap);
  }

  h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  /* --- Smart Export, on a dark field that matches its own site --- */
  .featured {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: #0b0b10;
    color: #eeeef3;
  }

  .featured-grid {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .featured h3 {
    font-size: clamp(2.25rem, 4.5vw, 4rem);
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .downloads {
    margin-top: 1.25rem;
    color: #b9b9c6;
  }

  .downloads .num {
    color: #eeeef3;
    font-weight: 600;
  }

  .featured-copy p:not(.downloads) {
    margin-top: 1rem;
    max-width: 40ch;
  }

  .featured-copy .links {
    margin-top: 1.5rem;
  }

  .featured :focus-visible {
    outline-color: #eeeef3;
  }

  .featured-shot img {
    width: 100%;
    height: auto;
  }

  /* --- the rest, as a list --- */
  .more {
    list-style: none;
    margin: clamp(3.5rem, 7vw, 6rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .more li {
    display: grid;
    gap: 1.25rem;
  }

  .thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .more li p {
    margin-top: 0.75rem;
    max-width: 56ch;
  }

  .more .stack {
    margin-top: 0.5rem;
    font-size: var(--step-small);
  }

  @media (min-width: 52rem) {
    .featured-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
    }

    .more li {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: center;
      gap: clamp(2rem, 4vw, 4rem);
    }
  }
</style>

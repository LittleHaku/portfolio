---
interface Props {
  items: string[];
  label?: string;
}

const { items, label = "Stack" } = Astro.props;
---

<ul class="stack" aria-label={label}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack li {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: var(--step-small);
    line-height: 1.2;
  }
</style>

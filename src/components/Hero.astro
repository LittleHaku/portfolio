---
import PourDemo from "./PourDemo.astro";
---

<section id="top" class="hero wrap">
  <div class="copy" data-reveal>
    <h1>Iván<br /> Sotillo</h1>
    <p class="statement">I build AI agents that talk and cameras that count beers.</p>
    <p class="support">
      Forward Deployed AI Engineer at <a class="link" href="https://gambooza.com">Gambooza</a>, in Madrid.
      I take AI from the first meeting with a client to production, and I publish research on
      LLM agents.
    </p>
    <div class="cta">
      <a class="btn" href="#contact">Get in touch</a>
      <a class="link" href="https://www.linkedin.com/in/ivansotillo/">LinkedIn</a>
      <a class="link" href="https://github.com/LittleHaku">GitHub</a>
      <a class="link" href="/documents/CV_Ivan_Sotillo.pdf" download>CV (PDF)</a>
    </div>
  </div>

  <div class="demo">
    <PourDemo />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 3rem;
    padding-top: clamp(2.5rem, 7vw, 6rem);
  }

  h1 {
    font-size: var(--step-display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.86;
    margin-left: -0.04em;
  }

  .statement {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    max-width: 22ch;
  }

  .support {
    margin-top: 1.25rem;
    max-width: 46ch;
    color: var(--ink-2);
    font-size: 1.125rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: end;
      gap: clamp(3rem, 5vw, 6rem);
    }

    h1 {
      font-size: clamp(6rem, 10.5vw, 10.5rem);
    }
  }
</style>

---
import PourDemo from "./PourDemo.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
import PDFIcon from "./icons/PDFIcon.astro";
---

<section id="top" class="hero wrap">
  <div class="copy" data-reveal>
    <p class="place muted">Madrid, Spain</p>
    <h1>Iván<br /> Sotillo</h1>
    <p class="statement">I'm a software engineer who builds AI products end to end.</p>
    <p class="support">
      LLM agents, computer vision, and the backends, integrations and web apps around them.
      Forward Deployed AI Engineer at <a class="link" href="https://gambooza.com">Gambooza</a> and
      published researcher on LLM agents.
    </p>
    <div class="cta">
      <a class="btn" href="#contact">Get in touch</a>
      <a class="icon-link" href="https://github.com/LittleHaku"><GitHubIcon aria-hidden="true" />GitHub</a>
      <a class="icon-link" href="https://www.linkedin.com/in/ivansotillo/"><LinkedInIcon aria-hidden="true" />LinkedIn</a>
      <a class="icon-link" href="/documents/CV_Ivan_Sotillo.pdf" download><PDFIcon aria-hidden="true" />CV</a>
    </div>
  </div>

  <div class="demo">
    <PourDemo />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 3rem;
    padding-top: clamp(2.5rem, 7vw, 6rem);
  }

  .place {
    margin-bottom: 1rem;
    font-size: 1.125rem;
  }

  h1 {
    font-size: var(--step-display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.86;
    margin-left: -0.04em;
  }

  .statement {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    max-width: 22ch;
  }

  .support {
    margin-top: 1.25rem;
    max-width: 48ch;
    color: var(--ink-2);
    font-size: 1.125rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--surface);
    font-weight: 500;
    text-decoration: none;
    transition: transform 160ms var(--ease-out), background-color 160ms ease;
  }

  .icon-link:hover {
    background: color-mix(in srgb, var(--surface) 80%, var(--ink));
  }

  .icon-link:active {
    transform: scale(0.97);
  }

  .icon-link :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: end;
      gap: clamp(3rem, 5vw, 6rem);
    }

    h1 {
      font-size: clamp(6rem, 10.5vw, 10.5rem);
    }
  }
</style>

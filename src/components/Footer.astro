---
const year = new Date().getFullYear();
---

<footer id="contact" class="contact">
  <div class="wrap">
    <div data-reveal>
      <h2 class="section-title">Let's build something real</h2>
      <p class="statement">
        If you're building a product and need someone to take it from the first conversation to
        production, I'd like to hear about it.
      </p>
      <a class="email" href="mailto:ivandelhorno@gmail.com">ivandelhorno@gmail.com</a>
      <p class="elsewhere">
        <a class="link" href="https://www.linkedin.com/in/ivansotillo/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="link" href="https://github.com/LittleHaku" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="link" href="/documents/CV_Ivan_Sotillo.pdf" download>CV (PDF)</a>
      </p>
    </div>

    <p class="legal">© {year} Iván Sotillo del Horno. Madrid.</p>
  </div>
</footer>

<style>
  .contact {
    margin-top: var(--section-gap);
    padding-block: clamp(5rem, 10vw, 9rem) 2rem;
    background: var(--field);
    color: var(--on-field);
  }

  .contact :focus-visible {
    outline-color: var(--signal);
  }

  .statement {
    margin-top: 2rem;
    max-width: 34ch;
  }

  .email {
    display: inline-block;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 6.4vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--on-field);
    text-decoration: none;
    overflow-wrap: anywhere;
    background-image: linear-gradient(var(--signal), var(--signal));
    background-size: 0% 0.05em;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 0.08em;
    transition: background-size 400ms var(--ease-out);
  }

  .email:hover {
    background-size: 100% 0.05em;
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 2rem;
    font-size: 1.125rem;
  }

  .legal {
    margin-top: clamp(5rem, 10vw, 8rem);
    color: var(--on-field-2);
    font-size: var(--step-small);
  }
</style>

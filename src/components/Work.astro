---
import RoleHeader from "./RoleHeader.astro";
import AgentChat from "./AgentChat.astro";

const RESULTS = [
  {
    figure: "0.998",
    title: "Recall detecting when a tap opens",
    text: "Per-venue YOLO models, measured on days held out for testing, with regions of interest that follow the tap when someone bumps the camera. The method now runs in more than 10 venues.",
  },
  {
    figure: "18",
    title: "Venues whose till data flows in by itself",
    text: "A multi-tenant pipeline on Cloud Functions and Firestore that ingests 72,000 to 180,000 sale lines a week from 6 POS systems and reconciles them with what the cameras saw.",
  },
  {
    figure: "1 min",
    title: "To send the weekly reports, down from half a day",
    text: "The client dashboard I built took us off Looker Studio and spreadsheets. It reads straight from Firestore and updates itself, so we check the reports and send them in about a minute.",
  },
  {
    figure: "−35%",
    title: "Nightly processing time per venue",
    text: "I redesigned the video pipeline: full-frame HD storage, rotation and cropping on the GPU, and audits that keep an eye on recall every night.",
  },
];

const SOFTWARE = [
  {
    title: "POS integrations",
    text: "BDP, Ágora, Glop, Square, Revo and Madisa, each with its own adapter. Revo with OAuth and PKCE, through the vendor's certification process.",
  },
  {
    title: "The client dashboard",
    text: "Per-venue and group views, benchmarks against the median venue and a sending workflow for every weekly report. It's what took us off Looker Studio.",
  },
  {
    title: "gambooza.com",
    text: "Designed from scratch and built by me: a completely new site, off WordPress and onto Firebase Hosting, with Playwright tests in CI and a design system the whole team now builds on.",
  },
]
---

<section id="work" class="work">
  <div class="wrap">
    <div class="intro" data-reveal>
      <h2 class="section-title">Work at Gambooza</h2>
      <div>
        <p class="statement">
          Gambooza puts cameras over the beer taps of bars and restaurants and checks every pour
          against the till.
        </p>
        <p class="body muted">
          I own projects end to end: the meetings with clients and POS
          vendors, the backend and the integrations, the client dashboard, the company website and
          the models that run every night in production.
        </p>
      </div>
    </div>

    <RoleHeader
      title="Forward Deployed AI Engineer"
      company="Gambooza"
      dates="May 2026 – now"
      stack={["Python", "YOLO", "Pydantic AI", "OpenClaw", "Google Cloud Functions", "Firestore", "Firebase Hosting", "Docker", "Playwright"]}
    />

    <div class="agent">
      <div class="agent-copy" data-reveal>
        <h3>An agent owners can text</h3>
        <p>
          Bar owners ask on WhatsApp, by text or voice note, and the agent answers from their own
          data: a table of last night's sales, a chart of the week, the weekly report as a PDF or the
          video clip of the pint that was never charged.
        </p>
        <p>
          Simple questions go through fixed workflows and open ones through the LLM. Every client gets
          its own container and can only see its own venues.
        </p>
        <p class="muted">Built with OpenClaw, Pydantic AI and Docker.</p>
      </div>

      <div class="stage">
        <AgentChat />
      </div>
    </div>

    <ul class="ledger">
      {RESULTS.map((result) => (
        <li data-reveal>
          <p class="figure num">{result.figure}</p>
          <div>
            <h3>{result.title}</h3>
            <p class="muted">{result.text}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="software">
      <h3 data-reveal><span>And the software around it</span></h3>
      <ul>
        {SOFTWARE.map((item) => (
          <li data-reveal>
            <h4>{item.title}</h4>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .work {
    margin-top: var(--section-gap);
  }

  .intro {
    display: grid;
    gap: 2rem;
  }

  .body {
    margin-top: 1.25rem;
    max-width: 52ch;
  }

  h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  /* --- the agent --- */
  .agent {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .agent-copy p {
    margin-top: 1rem;
    max-width: 48ch;
  }

  .stage {
    display: grid;
    place-items: center;
  }

  /* --- the ledger of results --- */
  .ledger {
    list-style: none;
    margin: clamp(4rem, 8vw, 7rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .ledger li {
    display: grid;
    gap: 0.75rem;
  }

  .figure {
    font-family: var(--font-display);
    font-size: var(--step-h2);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 0.9;
  }

  .ledger p.muted {
    margin-top: 0.6rem;
    max-width: 56ch;
  }

  /* --- the software around it --- */
  .software {
    margin-top: clamp(4rem, 8vw, 7rem);
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border-radius: 1.5rem;
    background: var(--surface);
  }

  .software ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  h4 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .software p {
    margin-top: 0.5rem;
    max-width: 52ch;
  }

  @media (min-width: 52rem) {
    .software ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem 3rem;
    }

    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    .agent {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }

    .ledger li {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: baseline;
      gap: 2rem;
    }
  }
</style>

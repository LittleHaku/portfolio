---
import SunIcon from "./icons/SunIcon.astro";
import MoonIcon from "./icons/MoonIcon.astro";
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme">
  <SunIcon class="icon icon-sun" aria-hidden="true" />
  <MoonIcon class="icon icon-moon" aria-hidden="true" />
</button>

<style>
  .theme-toggle {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 160ms ease, transform 160ms var(--ease-out);
  }

  .theme-toggle:hover {
    background: var(--surface);
  }

  .theme-toggle:active {
    transform: scale(0.94);
  }

  .theme-toggle :global(.icon) {
    grid-area: 1 / 1;
    width: 1.15rem;
    height: 1.15rem;
    transition: opacity 200ms ease, transform 300ms var(--ease-out);
  }

  /* Show the icon of the theme you would switch to. */
  .theme-toggle :global(.icon-sun) {
    opacity: 0;
    transform: rotate(-60deg) scale(0.8);
  }

  :global(.dark) .theme-toggle :global(.icon-sun) {
    opacity: 1;
    transform: none;
  }

  :global(.dark) .theme-toggle :global(.icon-moon) {
    opacity: 0;
    transform: rotate(60deg) scale(0.8);
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const label = () => {
    const dark = document.documentElement.classList.contains("dark");
    button?.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
  };

  button?.addEventListener("click", () => {
    const dark = document.documentElement.classList.contains("dark");
    (window as any).__setTheme?.(dark ? "light" : "dark");
    label();
  });
  label();
</script>

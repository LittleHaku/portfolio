---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { name: "Work", href: "#work" },
  { name: "Research", href: "#research" },
  { name: "Projects", href: "#projects" },
  { name: "About", href: "#about" },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href="#top" class="wordmark">Iván Sotillo</a>

    <nav aria-label="Sections" class="sections">
      {navItems.map((item) => (
        <a href={item.href} class="nav-link">{item.name}</a>
      ))}
    </nav>

    <div class="actions">
      <ThemeToggle />
      <a class="btn" href="#contact">Get in touch</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.25rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    text-decoration: none;
    margin-right: auto;
  }

  .sections {
    display: none;
    gap: 1.75rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--ink-2);
    transition: color 160ms ease;
  }

  .nav-link:hover,
  .nav-link[aria-current] {
    color: var(--ink);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .actions .btn {
    min-height: 2.5rem;
    padding: 0 1.1rem;
    font-size: 0.9375rem;
  }

  @media (min-width: 52rem) {
    .sections {
      display: flex;
    }
  }
</style>

<script>
  // Mark the section currently under the header in the nav.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link"));
  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => section !== null);

  let ticking = false;
  const update = () => {
    ticking = false;
    const line = 120;
    const active = sections.find((section) => {
      const rect = section.getBoundingClientRect();
      return rect.top <= line && rect.bottom > line;
    });
    links.forEach((link) => {
      if (active && link.hash === `#${active.id}`) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    },
    { passive: true },
  );
  update();
</script>

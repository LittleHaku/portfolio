---
import RoleHeader from "./RoleHeader.astro";

const TOOLS = [
  {
    title: "TRACER",
    image: "/screenshots/tracer.webp",
    alt: "A behaviour graph that TRACER inferred for a pizza-ordering chatbot: welcome, list pizza types, ask for details, confirm, ask for drinks, give the total.",
    text: "An agent that talks to any chatbot as a black box, maps what it can do and writes the test profiles for it. It reached 94% average precision on real production chatbots. It was my MSc thesis, graded 10/10.",
    links: [
      { label: "Paper", href: "https://link.springer.com/article/10.1007/s42979-026-05237-5" },
      { label: "Code", href: "https://github.com/Chatbot-TRACER/TRACER" },
      { label: "PyPI", href: "https://pypi.org/project/chatbot-tracer/" },
    ],
  },
  {
    title: "Chatbot Dōjō",
    image: "/screenshots/chatbot-dojo.webp",
    alt: "Chatbot Dōjō's test centre, with TRACER runs listed for a chatbot called ada.",
    text: "A full-stack platform I designed and built. It runs TRACER, the lab's Sensei user simulator and its correctness checks as one testing pipeline, and I presented it as a tool demo at ICSE 2026.",
    links: [
      { label: "Demo video", href: "https://www.youtube.com/watch?v=dFsbN1FKGVg" },
      { label: "Code", href: "https://github.com/satori-chatbots/chatbot-dojo" },
    ],
  },
];

const PUBLICATIONS = [
  {
    title: "Reverse Engineering of Chatbot Behaviour for Automated Testing",
    venue: "SN Computer Science, Springer",
    year: "2026",
    href: "https://link.springer.com/article/10.1007/s42979-026-05237-5",
  },
  {
    title: "Automated Testing of Conversational Agents with Chatbot Dōjō",
    venue: "ICSE 2026, Demonstrations track",
    year: "2026",
    href: "https://conf.researchr.org/details/icse-2026/icse-2026-demonstrations/7/Automated-Testing-of-Conversational-Agents-with-Chatbot-D-j-",
  },
  {
    title: "Automated Exploration of Conversational Agents for the Synthesis of Testing Profiles",
    venue: "ICTSS 2025, Springer",
    year: "2025",
    href: "https://link.springer.com/chapter/10.1007/978-3-032-05188-2_14",
  },
];
---

<section id="research" class="research">
  <div class="wrap">
    <div class="intro" data-reveal>
      <h2 class="section-title">Research on LLM agents</h2>
      <p class="statement">
        Before Gambooza I spent a year and a half in the MISO group at Universidad Autónoma de
        Madrid, building agents that test other chatbots.
      </p>
    </div>

    <RoleHeader
      title="Research Software Engineer"
      company="MISO group, Universidad Autónoma de Madrid"
      dates="Dec 2024 – Apr 2026"
      stack={["Python", "LangGraph", "Django REST", "React", "PostgreSQL", "Celery", "Docker", "GitHub Actions"]}
    />

    <div class="tools">
      {TOOLS.map((tool) => (
        <article class="tool" data-reveal>
          <div class="shot">
            <img src={tool.image} alt={tool.alt} loading="lazy" decoding="async" />
          </div>
          <div class="tool-copy">
            <h3>{tool.title}</h3>
            <p>{tool.text}</p>
            <p class="links">
              {tool.links.map((link) => (
                <a class="link" href={link.href}>{link.label}</a>
              ))}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="papers" data-reveal>
      <h3>Publications</h3>
      <ol>
        {PUBLICATIONS.map((paper) => (
          <li>
            <a class="link paper-title" href={paper.href}>{paper.title}</a>
            <span class="muted">{paper.venue}, {paper.year}</span>
          </li>
        ))}
      </ol>
      <p class="muted note">
        Along the way I also wrote Chatbot Connector, a Python library that lets the same tests talk
        to chatbots built on Rasa, LangChain or the OpenAI API, released to PyPI with GitHub Actions.
      </p>
    </div>
  </div>
</section>

<style>
  .research {
    margin-top: var(--section-gap);
  }

  .intro {
    display: grid;
    gap: 2rem;
  }

  h3 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .tools {
    display: grid;
    gap: clamp(4rem, 8vw, 7rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .tool {
    display: grid;
    gap: 1.75rem;
  }

  .shot {
    border-radius: 1.25rem;
    background: var(--surface);
    overflow: hidden;
    aspect-ratio: 3 / 2;
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .tool:first-child .shot {
    background: #fff;
  }

  .tool:first-child .shot img {
    object-fit: contain;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .tool-copy p {
    margin-top: 1rem;
    max-width: 46ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .papers {
    margin-top: clamp(4rem, 8vw, 7rem);
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border-radius: 1.5rem;
    background: var(--surface);
  }

  .papers ol {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  .papers li {
    display: grid;
    gap: 0.3rem;
  }

  .paper-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.2;
    max-width: 40ch;
  }

  .note {
    margin-top: 2.5rem;
    max-width: 60ch;
  }

  @media (min-width: 52rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    .tool {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: clamp(2rem, 4vw, 4rem);
    }

    .tool:nth-child(even) .shot {
      order: 2;
    }
  }
</style>
